{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-books",
      "urls": ["http://localhost:8080/admin/books/**"],
      "cacheConfig": {
        "maxSize": 5,
        "maxAge": "12h",
        "strategy": "performance"
      }
    },
    {
      "name": "api-reservations",
      "urls": ["http://localhost:8080/api/reservations/**"],
      "cacheConfig": {
        "maxSize": 5,
        "maxAge": "1h",
        "strategy": "freshness"
      }
    }
  ],
  "navigationUrls": [
    "/**"
  ]
}
